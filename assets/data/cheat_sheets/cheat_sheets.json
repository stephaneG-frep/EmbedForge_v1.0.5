[
  {
    "id": "cheat_terminal",
    "title": "Commandes terminal",
    "icon": "terminal",
    "accent": "green",
    "intro": "Les réflexes pour naviguer et interroger le système depuis un shell.",
    "sections": [
      {
        "title": "Navigation",
        "entries": [
          ["cd ..", "remonte d'un répertoire"],
          ["cd ~", "va dans le dossier personnel"],
          ["pwd", "affiche le dossier courant"],
          ["ls -la", "liste les fichiers, y compris cachés, en détail"],
          ["ls -lh", "liste avec des tailles lisibles"]
        ]
      },
      {
        "title": "Consultation",
        "entries": [
          ["cat fichier", "affiche tout le contenu d'un fichier"],
          ["less fichier", "parcourt un fichier page par page"],
          ["head -n 20 fichier", "montre les 20 premières lignes"],
          ["tail -f journal.log", "suit en continu la fin d'un fichier"],
          ["grep motif fichier", "cherche motif dans un fichier"]
        ]
      },
      {
        "title": "Raccourcis utiles",
        "entries": [
          ["Ctrl+C", "interrompt la commande en cours"],
          ["Ctrl+Z", "suspend la commande"],
          ["Ctrl+R", "recherche dans l'historique"],
          ["Ctrl+D", "ferme le terminal"],
          ["!!", "répète la dernière commande"],
          ["history", "affiche l'historique des commandes"]
        ]
      }
    ]
  },
  {
    "id": "cheat_fichiers",
    "title": "Fichiers & permissions",
    "icon": "inventory",
    "accent": "blue",
    "intro": "Manipulez les fichiers et maîtrisez les droits, essentiel sur un système embarqué multi-utilisateurs.",
    "sections": [
      {
        "title": "Manipulation",
        "entries": [
          ["cp -r src dest", "copie un dossier récursivement"],
          ["mv fichier dest", "déplace ou renomme"],
          ["rm -rf dossier", "supprime un dossier sans confirmation"],
          ["mkdir -p a/b/c", "crée l'arborescence complète"],
          ["touch fichier", "crée un fichier vide ou met à jour sa date"],
          ["ln -s cible lien", "crée un lien symbolique"],
          ["du -sh dossier", "taille totale d'un dossier"]
        ]
      },
      {
        "title": "Permissions",
        "entries": [
          ["chmod 755 script", "propriétaire rwx, groupe et autres rx"],
          ["chmod u+x fichier", "ajoute le droit d'exécution au propriétaire"],
          ["chmod -R 640 dossier", "applique récursivement 640"],
          ["chown user:group fichier", "change propriétaire et groupe"],
          ["umask 022", "masque les droits par défaut des créations"],
          ["stat fichier", "détaille les droits et l'horodatage"],
          ["lsattr fichier", "affiche les attributs étendus du fichiersysteme"]
        ]
      },
      {
        "title": "Connaître ses fichiers",
        "entries": [
          ["file binaire", "détecte le type d'un fichier"],
          ["find / -name *.conf", "cherche des fichiers par nom"],
          ["locate motif", "cherche via une base indexée"],
          ["which gcc", "localise un exécutable du PATH"],
          ["df -h", "espace libre par système de fichiers"]
        ]
      }
    ]
  },
  {
    "id": "cheat_processus",
    "title": "Processus & ressources",
    "icon": "speed",
    "accent": "orange",
    "intro": "Observez, pesez et pilotez les processus courts et longs de votre système.",
    "sections": [
      {
        "title": "Supervision",
        "entries": [
          ["ps aux", "liste tous les processus avec CPU et mémoire"],
          ["pgrep -f python", "trouve les PID d'un processus par motif"],
          ["pstree -p", "affiche l'arborescence des processus"],
          ["top", "moniteur de processus en temps réel"],
          ["htop", "version colorée et interactive de top"],
          ["uptime", "charge moyenne et temps de disponibilité"]
        ]
      },
      {
        "title": "Signaux",
        "entries": [
          ["kill 1234", "envoie SIGTERM, arrêt propre"],
          ["kill -9 1234", "envoie SIGKILL, arrêt forcé"],
          ["killall -TERM python3", "termine tous les python3"],
          ["pkill -f moniteur", "termine selon le nom de commande"],
          ["nohup cmd &", "lance cmd à l'abri du déconnecter ssh"]
        ]
      },
      {
        "title": "Ressources",
        "entries": [
          ["free -h", "mémoire utilisée et disponible"],
          ["df -h", "occupation des disques"],
          ["vmstat 2", "statistiques mémoire et CPU toutes les 2 s"],
          ["ulimit -a", "limites de ressources du shell"],
          ["ionice -c 3 cmd", "lance cmd en priorité d'E/S la plus basse"],
          ["nice -n 10 cmd", "lance cmd avec priorité CPU abaissée"]
        ]
      }
    ]
  },
  {
    "id": "cheat_bash",
    "title": "Bash & scripts",
    "icon": "code",
    "accent": "teal",
    "intro": "Les briques de script bash qui rendent vos automatisations fiables et lisibles.",
    "sections": [
      {
        "title": "Variables",
        "entries": [
          ["nom=value", "affecte une variable (sans espace)"],
          ["echo \"$nom\"", "utilise la valeur de la variable"],
          ["export VAR=valeur", "exporte une variable vers les fils"],
          ["$(commande)", "substitue le résultat d'une commande"],
          ["${var:-defaut}", "valeur par défaut si var est vide"],
          ["printf \"%s\\n\" \"$x\"", "forme texte sans ambiguïté"]
        ]
      },
      {
        "title": "Conditions et boucles",
        "entries": [
          ["if [ -f fichier ]; then", "si le fichier existe"],
          ["for f in *.conf; do", "boucle sur des fichiers"],
          ["while read ligne; do", "lit un fichier ligne à ligne"],
          ["case \"$x\" in a) ;; esac", "sélection multi-branches"],
          ["cmd1 && cmd2", "exécute cmd2 si cmd1 réussit"],
          ["cmd1 || echo echec", "exécute si cmd1 échoue"]
        ]
      },
      {
        "title": "Fiabilité",
        "entries": [
          ["set -euo pipefail", "arrêt sur erreur, variables vérifiées"],
          ["trap 'cleanup' EXIT", "exécute cleanup à la sortie"],
          ["ls *.conf | xargs grep toto", "applique grep sur une liste"],
          ["command -v gcc", "vérifie la présence d'un exécutable"],
          ["#! /usr/bin/env bash", "shebang portable du script"]
        ]
      }
    ]
  },
  {
    "id": "cheat_systemd",
