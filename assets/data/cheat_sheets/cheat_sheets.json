      {
        "title": "État des unités",
        "entries": [
          ["systemctl status moniteur", "état détaillé d'une unité"],
          ["systemctl list-units", "liste les unités chargées"],
          ["systemctl list-unit-files", "liste les unités avec état enabled"],
          ["systemctl list-timers", "affiche les timers planifiés"],
          ["systemctl get-default", "cible de démarrage par défaut"]
        ]
      },
      {
        "title": "Contrôle des services",
        "entries": [
          ["systemctl start unit", "démarre une unité"],
          ["systemctl stop unit", "arrête une unité"],
          ["systemctl restart unit", "redémarre une unité"],
          ["systemctl reload unit", "recharge la configuration sans couper"],
          ["systemctl enable --now unit", "active au boot et démarre"],
          ["systemctl disable unit", "désactive au boot"],
          ["systemctl mask unit", "empêche toute activation"]
        ]
      },
      {
        "title": "Analyse",
        "entries": [
          ["systemctl daemon-reload", "recharge les unités modifiées"],
          ["systemctl cat unit", "affiche le contenu de l'unité"],
          ["systemd-analyze blame", "durée de démarrage par unité"],
          ["systemd-analyze critical-chain", "chaîne critique du boot"],
          ["journalctl -u unit -e", "fin du journal d'une unité"]
        ]
      }
    ]
  },
  {
    "id": "cheat_journaux",
    "title": "Journaux",
    "icon": "book",
    "accent": "yellow",
    "intro": "Interrogez les journaux journald avec des filtres précis et gérez la rotation.",
    "sections": [
      {
        "title": "journalctl",
        "entries": [
          ["journalctl", "affiche tout le journal"],
          ["journalctl -u moniteur", "filtre par unité"],
          ["journalctl -p err", "filtre par priorité et au-dessus"],
          ["journalctl -k", "messages du noyau seulement"],
          ["journalctl -b", "depuis le dernier démarrage"],
          ["journalctl -f", "suit en continu"],
          ["journalctl -n 50", "dernières 50 lignes"]
        ]
      },
      {
        "title": "Filtres temporels",
        "entries": [
          ["--since \"2 hours ago\"", "depuis deux heures"],
          ["--since today", "depuis minuit"],
          ["--since \"2026-08-27 08:00\"", "depuis une date précise"],
          ["--until \"2026-08-27 12:00\"", "jusqu'à une date précise"],
          ["-S -30min", "forme courte depuis 30 minutes"]
        ]
      },
      {
        "title": "Rotation et volume",
        "entries": [
          ["journalctl --disk-usage", "espace occupé"],
          ["journalctl --vacuum-size=50M", "réduit à 50 Mo en supprimant"],
          ["journalctl --vacuum-time=7d", "garde les 7 derniers jours"],
          ["SystemMaxUse=100M", "borne la taille dans journald.conf"],
          ["systemctl restart systemd-journald", "recharge la config"]
        ]
      }
    ]
  },
