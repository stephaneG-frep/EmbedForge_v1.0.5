  {
    "id": "cheat_gpio",
    "title": "GPIO & sysfs",
    "icon": "bolt",
    "accent": "green",
    "intro": "Pilotez les broches d'entrée-sortie en ligne de commande, avec l'API moderne libgpiod et l'héritage sysfs.",
    "sections": [
      {
        "title": "libgpiod (moderne)",
        "entries": [
          ["gpiodetect", "liste les contrôleurs GPIO"],
          ["gpioinfo gpiochip0", "détaille les lignes du contrôleur"],
          ["gpioget gpiochip0 17", "lit la valeur d'une broche"],
          ["gpioset gpiochip0 17=1", "met la broche au niveau haut"],
          ["gpiomon -r gpiochip0 17", "surveille les fronts montants"],
          ["gpiofind \"LED rouge\"", "trouve la ligne par étiquette"]
        ]
      },
      {
        "title": "sysfs (historique)",
        "entries": [
          ["echo 17 > /sys/class/gpio/export", "exporte la GPIO 17"],
          ["echo out > .../direction", "configure en sortie"],
          ["echo in > .../direction", "configure en entrée"],
          ["echo 1 > .../value", "écrit le niveau haut"],
          ["cat .../value", "lit le niveau"],
          ["echo 17 > unexport", "libère la GPIO"]
        ]
      },
      {
        "title": "Montage type",
        "entries": [
          ["LED + résistance 330 ohm", "chaîne de mesure sur la broche"],
          ["bouton + pull-up", "lecture inversée fiable"],
          ["gpioset -l 1A", "jeu de lignes en une commande"],
          ["watch -n0.2 gpioset...", "suit une broche en continu"]
        ]
      }
    ]
  },
  {
    "id": "cheat_bus",
    "title": "Bus I2C/SPI/UART",
    "icon": "link",
    "accent": "teal",
    "intro": "Les outils de diagnostic et de configuration des trois bus série les plus courants en embarqué.",
    "sections": [
      {
        "title": "I2C",
        "entries": [
          ["i2cdetect -y 1", "liste les adresses répondant sur le bus"],
          ["i2cget -y 1 0x76 0xd0", "lit un registre (chip id)"],
          ["i2cset -y 1 0x76 0xf4 0x27", "écrit un registre"],
          ["i2cdump -y 1 0x76", "déverse tous les registres"],
          ["ls /dev/i2c-*", "liste les bus I2C actifs"]
        ]
      },
      {
        "title": "SPI",
        "entries": [
          ["ls /dev/spidev*", "liste les bus SPI actifs"],
          ["spidev_test -D /dev/spidev0.0", "teste un bus avec un motif"],
          ["dtoverlay spi0-1cs", "active un périphérique SPI"],
          ["cat /sys/class/spi_master", "aperçu des contrôleurs SPI"],
          ["spidev_test -p \"\\x01\\x02\"", "envoie des octets précis"]
        ]
      },
      {
        "title": "UART",
        "entries": [
          ["stty -F /dev/ttyS0 115200", "configure le débit du port"],
          ["minicom -D /dev/ttyS0 -b 115200", "ouvre un terminal série"],
          ["cu -l /dev/ttyS0 115200", "connexion série simple"],
          ["socat pty,raw,echo=0 pty,raw,echo=0", "paire série virtuelle de test"],
          ["picocom -b 115200 /dev/ttyUSB0", "terminal série léger"]
        ]
      }
    ]
  },
